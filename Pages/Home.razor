@page "/"
@using System.Globalization
@using System.Text.Json
@using SpiderBlazor.Game
@using SpiderBlazor.Localization
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Spider</PageTitle>

<div class="table">
    <div class="board @(dimFixed ? "dim-fixed" : "")" @ref="boardEl">
        @if (cw > 0)
        {
            <div class="slots">
                @for (var c = 0; c < 10; c++)
                {
                    <div class="slot" style="@SlotStyle(c)"></div>
                }
            </div>
            <div class="cards">
                @foreach (var p in PlaceCards())
                {
                    <div @key="p.Card.Id" class="@CardClass(p)" data-col="@p.Col" data-idx="@p.Index" style="@p.Style">
                        @if (p.Card.FaceUp)
                        {
                            @CardSvg.Face(p.Card.Rank, p.Card.Suit, lang)
                        }
                    </div>
                }
            </div>

            @* Top row: completed runs left, stock right *@
            <div class="toprow">
                @for (var i = 0; i < game.State.Completed.Count; i++)
                {
                    var suit = game.State.Completed[i];
                    <div class="card up s@((int)suit)" style="@TopCardStyle(ColX(i), i)">
                        @CardSvg.Face(13, suit, lang)
                    </div>
                }
                <div class="slot stock-slot" style="@TopCardStyle(ColX(9), 0)"></div>
                <div class="stock @(game.CanDeal ? "" : "dim")" @onclick="Deal">
                    @for (var i = 0; i < game.DealsLeft; i++)
                    {
                        <div class="card down" style="@TopCardStyle(ColX(9) - i * cw * 0.12, i + 1)"></div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@* Bottom sheet with all controls; toggled by tapping the empty table or the handle *@
<button class="sheet-handle @(menuOpen ? "hidden" : "")" @onclick="() => menuOpen = true" aria-label="Menu"></button>
<nav class="sheet @(menuOpen ? "open" : "")">
    <div class="sheet-stats">@T("Score") @game.State.Score · @T("Moves") @game.State.Moves</div>
    <div class="sheet-buttons">
        <button class="sheet-btn new" @onclick="NewClicked">@Icon("new")<span>@T("New")</span></button>
        <button class="sheet-btn restart" @onclick="RestartClicked" disabled="@(!game.CanRestart)">@Icon("restart")<span>@T("Restart")</span></button>
        <button class="sheet-btn undo" @onclick="Undo" disabled="@(!game.CanUndo)">@Icon("undo")<span>@T("Undo")</span></button>
        <button class="sheet-btn hint" @onclick="HintFromMenu">@Icon("hint")<span>@T("Hint")</span></button>
        <button class="sheet-btn settings" @onclick="OpenSettings">@Icon("settings")<span>@T("Settings")</span></button>
    </div>
</nav>

@if (message is not null)
{
    <div class="toast">@message</div>
}

@if (showSettings)
{
    <div class="overlay" @onclick="() => showSettings = false">
        <div class="dialog settings" @onclick:stopPropagation="true">
            <h2>@T("Settings")</h2>

            <h3>@T("Difficulty")</h3>
            <div class="options">
                @foreach (var level in Levels)
                {
                    <button class="option @(suits == level.Suits ? "selected" : "")" @onclick="() => SetSuits(level.Suits)">
                        <span class="opt-title">@T(level.Key)</span>
                        <span class="opt-sub">@T(level.SuitKey) @SuitIcons(level.Suits)</span>
                        <span class="opt-wins">@wins[level.Index] @T("Won")</span>
                    </button>
                }
            </div>
            @if (suits != game.State.SuitCount)
            {
                <p class="note">@T("NextGame")</p>
                <button class="btn" @onclick="StartFromSettings">@T("StartNow")</button>
            }

            <h3>@T("Display")</h3>
            <button class="option @(dimFixed ? "selected" : "")" @onclick="ToggleDimFixed">
                <span class="opt-title">@T("HighlightMovable")</span>
                <span class="opt-wins">@T(dimFixed ? "On" : "Off")</span>
            </button>

            <h3>@T("Language")</h3>
            <div class="langs">
                @foreach (var l in Text.All)
                {
                    <button class="option small @(lang == l ? "selected" : "")" @onclick="() => SetLang(l)">@Text.Name(l)</button>
                }
            </div>

            <button class="btn secondary" @onclick="() => showSettings = false">@T("Close")</button>
        </div>
    </div>
}
else if (showNewGame)
{
    <div class="overlay" @onclick="() => showNewGame = false">
        <div class="dialog" @onclick:stopPropagation="true">
            <h2>@T("NewGame")</h2>
            <p>@T("StartNewQ")</p>
            <p class="opt-sub">@T(CurrentLevel.Key) · @T(CurrentLevel.SuitKey) @SuitIcons(suits)</p>
            <button class="btn" @onclick="StartGame">@T("Start")</button>
            <button class="btn secondary" @onclick="() => showNewGame = false">@T("Cancel")</button>
        </div>
    </div>
}
else if (showRestart)
{
    <div class="overlay" @onclick="() => showRestart = false">
        <div class="dialog" @onclick:stopPropagation="true">
            <h2>@T("Restart")</h2>
            <p>@T("RestartQ")</p>
            <button class="btn" @onclick="RestartGame">@T("Restart")</button>
            <button class="btn secondary" @onclick="() => showRestart = false">@T("Cancel")</button>
        </div>
    </div>
}
else if (game.IsWon)
{
    <div class="overlay">
        <div class="dialog">
            <h2>@T("YouWon")</h2>
            <p>@T("Score") @game.State.Score · @T("Moves") @game.State.Moves</p>
            <button class="btn" @onclick="StartGame">@T("NewGame")</button>
            <button class="btn secondary" @onclick="RestartGame">@T("Restart")</button>
        </div>
    </div>
}

@code {
    private const string SaveKey = "spider.game";
    private const string WinsKey = "spider.wins";
    private const string SuitsKey = "spider.suits";
    private const string LangKey = "spider.lang";
    private const string DimKey = "spider.dimfixed";

    private readonly record struct Level(int Suits, string Key, string SuitKey, int Index);

    private static readonly Level[] Levels =
    [
        new(1, "Easy", "Suit1", 0),
        new(2, "Medium", "Suit2", 1),
        new(4, "Hard", "Suit4", 2)
    ];

    private readonly SpiderGame game = new();
    private readonly Dictionary<int, int> freshOrder = [];
    private int[] wins = [0, 0, 0];
    private int suits = 4;
    private Lang lang = Lang.Nl;

    private ElementReference boardEl;
    private DotNetObjectReference<Home>? selfRef;

    private double boardH, cw, gap, offsetX;
    private int? shakeId;
    private string? message;
    private bool showNewGame, showSettings, winRecorded;
    private bool dimFixed, menuOpen, showRestart;

    private readonly record struct Placed(Card Card, int Col, int Index, string Style);

    private Level CurrentLevel => Levels.First(l => l.Suits == suits);

    private string T(string key) => Text.Get(lang, key);

    protected override void OnInitialized() => MarkAllFresh();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
        selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("spider.init", selfRef, boardEl);
    }

    // MARK: JS callbacks

    [JSInvokable]
    public void OnResize(double w, double h)
    {
        boardH = h;
        gap = Math.Max(3, w * 0.006);
        var byWidth = (w - gap * 11) / 10;
        var byHeight = h / 4.2 / 1.4;
        cw = Math.Max(10, Math.Min(byWidth, byHeight));
        offsetX = (w - (cw * 10 + gap * 9)) / 2;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnTap(int col, int index)
    {
        if (game.IsWon || col < 0 || col > 9 || index < 0 || index >= game.Columns[col].Count) return;
        var card = game.Columns[col][index];
        if (game.Tap(col, index))
        {
            freshOrder.Clear();
            await AfterChangeAsync();
            return;
        }
        shakeId = card.Id;
        StateHasChanged();
        await Task.Delay(350);
        if (shakeId == card.Id)
        {
            shakeId = null;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task<bool> OnDrop(int from, int index, int to)
    {
        if (game.IsWon || !game.Move(from, index, to)) return false;
        freshOrder.Clear();
        await AfterChangeAsync();
        return true;
    }

    // MARK: Actions

    [JSInvokable]
    public void OnEmptyTap()
    {
        menuOpen = !menuOpen;
        StateHasChanged();
    }

    private async Task NewClicked()
    {
        menuOpen = false;
        // Ask only when a game is in progress
        if (game.State.Moves > 0 && !game.IsWon) showNewGame = true;
        else await StartGame();
    }

    private void RestartClicked()
    {
        menuOpen = false;
        showRestart = true;
    }

    private async Task RestartGame()
    {
        if (!game.Restart()) return;
        MarkAllFresh();
        showRestart = false;
        winRecorded = false;
        await AfterChangeAsync();
    }

    private async Task HintFromMenu()
    {
        menuOpen = false;
        await ShowHint();
    }

    private void OpenSettings()
    {
        menuOpen = false;
        showSettings = true;
    }

    private async Task Deal()
    {
        if (game.State.Stock.Count == 0) return;
        if (!game.CanDeal)
        {
            Flash(T("FillEmpty"));
            return;
        }
        var ids = game.Deal();
        freshOrder.Clear();
        for (var i = 0; i < ids.Count; i++) freshOrder[ids[i]] = i;
        await AfterChangeAsync();
    }

    private async Task Undo()
    {
        game.Undo();
        freshOrder.Clear();
        await AfterChangeAsync();
    }

    private async Task ShowHint()
    {
        game.FindHint();
        if (game.Hint is not { } hint)
        {
            Flash(T(game.CanDeal ? "NoMovesDeal" : "NoMoves"));
            return;
        }
        StateHasChanged();
        await Task.Delay(2000);
        if (game.Hint == hint) game.Hint = null;
    }

    private async Task StartGame()
    {
        game.NewGame(suits);
        MarkAllFresh();
        showNewGame = false;
        showSettings = false;
        winRecorded = false;
        await AfterChangeAsync();
    }

    private Task StartFromSettings() => StartGame();

    private async Task SetSuits(int value)
    {
        suits = value;
        await SetItemAsync(SuitsKey, value.ToString(CultureInfo.InvariantCulture));
    }

    private async Task ToggleDimFixed()
    {
        dimFixed = !dimFixed;
        await SetItemAsync(DimKey, dimFixed ? "1" : "0");
    }

    private async Task SetLang(Lang value)
    {
        lang = value;
        await SetItemAsync(LangKey, Text.Code(value));
    }

    private async Task AfterChangeAsync()
    {
        StateHasChanged();
        if (game.IsWon && !winRecorded)
        {
            winRecorded = true;
            wins[game.State.SuitCount switch { 1 => 0, 2 => 1, _ => 2 }]++;
            await SetItemAsync(WinsKey, JsonSerializer.Serialize(wins, SpiderJson.Default.Int32Array));
        }
        await SetItemAsync(SaveKey, JsonSerializer.Serialize(game.State, SpiderJson.Default.GameState));
    }

    private void Flash(string text)
    {
        message = text;
        StateHasChanged();
        _ = ClearFlashAsync(text);
    }

    private async Task ClearFlashAsync(string text)
    {
        await Task.Delay(2000);
        if (message != text) return;
        message = null;
        StateHasChanged();
    }

    // Deal-in animation order: row by row, left to right
    private void MarkAllFresh()
    {
        freshOrder.Clear();
        var order = 0;
        for (var row = 0; row < 6; row++)
            for (var c = 0; c < 10; c++)
                if (row < game.Columns[c].Count)
                    freshOrder[game.Columns[c][row].Id] = order++;
    }

    // MARK: Storage

    private async Task LoadAsync()
    {
        try
        {
            dimFixed = await JS.InvokeAsync<string?>("localStorage.getItem", DimKey) == "1";

            var langCode = await JS.InvokeAsync<string?>("localStorage.getItem", LangKey)
                           ?? await JS.InvokeAsync<string?>("spider.language");
            lang = Text.FromCode(langCode);

            var suitsText = await JS.InvokeAsync<string?>("localStorage.getItem", SuitsKey);
            if (int.TryParse(suitsText, out var s) && s is 1 or 2 or 4) suits = s;

            var winsJson = await JS.InvokeAsync<string?>("localStorage.getItem", WinsKey);
            if (winsJson is not null && JsonSerializer.Deserialize(winsJson, SpiderJson.Default.Int32Array) is { Length: 3 } w)
                wins = w;

            var json = await JS.InvokeAsync<string?>("localStorage.getItem", SaveKey);
            if (json is not null && JsonSerializer.Deserialize(json, SpiderJson.Default.GameState) is { } state && state.IsValid())
            {
                game.Restore(state);
                freshOrder.Clear();
                winRecorded = game.IsWon;
            }
            else if (suits != game.State.SuitCount)
            {
                game.NewGame(suits);
                MarkAllFresh();
            }
        }
        catch
        {
            // Corrupt or unavailable storage: keep the fresh game
        }
        StateHasChanged();
    }

    private async Task SetItemAsync(string key, string value)
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", key, value); }
        catch { /* storage full or blocked */ }
    }

    // MARK: Layout

    private List<Placed> PlaceCards()
    {
        var ch = cw * 1.4;
        var list = new List<Placed>(104);
        for (var c = 0; c < 10; c++)
        {
            var col = game.Columns[c];
            var ys = YOffsets(col, ch);
            var x = ColX(c);
            for (var i = 0; i < col.Count; i++)
            {
                var delay = freshOrder.TryGetValue(col[i].Id, out var o) ? $"animation-delay:{o * 18}ms;" : "";
                list.Add(new Placed(col[i], c, i,
                    $"left:{Px(x)};top:{Px(RowTop + ys[i])};width:{Px(cw)};height:{Px(ch)};font-size:{Px(cw)};z-index:{i + 1};{delay}"));
            }
        }
        // Stable DOM order keeps CSS transitions alive when cards change column
        list.Sort((a, b) => a.Card.Id.CompareTo(b.Card.Id));
        return list;
    }

    // Compress spacing when a column gets too tall
    private double[] YOffsets(List<Card> col, double ch)
    {
        var down = ch * 0.12;
        var up = ch * 0.28;
        var nDown = col.Count(k => !k.FaceUp);
        var nUp = Math.Max(col.Count(k => k.FaceUp) - 1, 0);
        var avail = boardH - RowTop - ch - 4;

        if (nUp > 0 && nDown * down + nUp * up > avail)
            up = Math.Max((avail - nDown * down) / nUp, ch * 0.17);
        if (nDown > 0 && nDown * down + nUp * up > avail)
            down = Math.Max((avail - nUp * up) / nDown, ch * 0.04);

        var ys = new double[col.Count];
        double y = 0;
        for (var i = 0; i < col.Count; i++)
        {
            ys[i] = y;
            y += col[i].FaceUp ? up : down;
        }
        return ys;
    }

    private double ColX(int c) => offsetX + c * (cw + gap);

    // Tableau starts below the top row (completed runs + stock)
    private double RowTop => cw * 1.4 + gap * 3;

    private string SlotStyle(int c) =>
        $"left:{Px(ColX(c))};top:{Px(RowTop)};width:{Px(cw)};height:{Px(cw * 1.4)};border-radius:{Px(cw * 0.08)}";

    private string TopCardStyle(double x, int z) =>
        $"left:{Px(x)};top:0;width:{Px(cw)};height:{Px(cw * 1.4)};font-size:{Px(cw)};border-radius:{Px(cw * 0.08)};z-index:{z}";

    private string CardClass(Placed p)
    {
        var cls = p.Card.FaceUp ? "card up" : "card down";
        if (p.Card.FaceUp) cls += $" s{(int)p.Card.Suit}";
        if (game.CanPickUp(p.Col, p.Index)) cls += " movable";
        if (IsHinted(p.Col, p.Index)) cls += " hint";
        if (shakeId == p.Card.Id) cls += " shake";
        if (freshOrder.ContainsKey(p.Card.Id)) cls += " fresh";
        return cls;
    }

    private bool IsHinted(int col, int index) =>
        game.Hint is { } h
        && ((h.From == col && index >= h.Index) || (h.To == col && index == game.Columns[col].Count - 1));

    // Line icons for the menu buttons
    private static MarkupString Icon(string name)
    {
        var paths = name switch
        {
            "new" => "<rect x=\"6\" y=\"3\" width=\"12\" height=\"18\" rx=\"2\"/><path d=\"M12 9v6M9 12h6\"/>",
            "restart" => "<path d=\"M3.5 12a8.5 8.5 0 1 0 2.6-6.1\"/><path d=\"M3 4v5h5\"/>",
            "undo" => "<path d=\"M9 14 4 9l5-5\"/><path d=\"M4 9h10.5a5.5 5.5 0 0 1 0 11H11\"/>",
            "hint" => "<path d=\"M9 18h6M10 21h4\"/><path d=\"M12 3a6 6 0 0 0-3.8 10.6c.6.5.8 1.2.8 1.9V16h6v-.5c0-.7.2-1.4.8-1.9A6 6 0 0 0 12 3z\"/>",
            _ => "<path d=\"M4 7h9M17 7h3M4 17h3M11 17h9\"/><circle cx=\"15\" cy=\"7\" r=\"2\"/><circle cx=\"9\" cy=\"17\" r=\"2\"/>"
        };
        return new MarkupString(
            $"<span class=\"chip\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{paths}</svg></span>");
    }

    // Small suit icons for the difficulty options
    private static MarkupString SuitIcons(int count)
    {
        var icons = string.Concat(Enumerable.Range(0, count).Select(s =>
            $"<svg class=\"ico s{s}\" viewBox=\"0 0 100 100\"><use href=\"#suit-{s}\"/></svg>"));
        return new MarkupString($"<span class=\"icons\">{icons}</span>");
    }

    private static string PileWidth(int n, double step) =>
        $"width:calc(var(--mw) * {F(1 + step * Math.Max(n - 1, 0))})";

    private static string MiniOffset(string side, int i, double step) =>
        $"{side}:calc(var(--mw) * {F(i * step)})";

    private static string Px(double v) => F(v) + "px";

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("spider.dispose"); }
        catch (JSDisconnectedException) { }
        selfRef?.Dispose();
    }
}
